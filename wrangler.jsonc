{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cartagena-indigo",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, el nombre del servicio debe coincidir con el nombre del worker
			// ver https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cartagena-indigo"
		}
	],
	"r2_buckets": [
		// Cache incremental (ISR/SSG) en R2
		// ver https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Crear el bucket antes de desplegar:
			// npx wrangler r2 bucket create cartagena-indigo-opennext-cache
			"bucket_name": "cartagena-indigo-opennext-cache"
		}
	],
	"images": {
		// Habilita la optimización nativa de imágenes de Cloudflare para next/image
		// ver https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
